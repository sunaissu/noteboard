{
  "name": "@sunaissu/noteboard",
  "version": "2.0.1",
  "description": "A highly customizable, responsive React whiteboard canvas for drawing, diagramming, and real-time collaboration.",
  "keywords": [
    "react",
    "canvas",
    "whiteboard",
    "drawing",
    "noteboard",
    "diagram"
  ],
  "homepage": "https://github.com/sunaissu/noteboard#readme",
  "bugs": {
    "url": "https://github.com/sunaissu/noteboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaissu/noteboard.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "sunaissu",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./yjs": {
      "types": "./dist/yjs.d.ts",
      "import": "./dist/yjs.mjs",
      "require": "./dist/yjs.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup ./src/index.tsx ./src/yjs.ts --format cjs,esm --dts --clean",
    "dev": "tsup ./src/index.tsx ./src/yjs.ts --format cjs,esm --dts --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && npm run build && npm run test:unit",
    "test:unit": "node --test",
    "playground": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "yjs": "^13.6.31"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "yjs": "^13.6.31"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "sideEffects": false
}
